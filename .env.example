# Public hostname only: no scheme, port, or path.
DOMAIN=wreckage.example.com
POSTGRES_DB=wreckage
POSTGRES_USER=wreckage
# Absolute host path to a separate root-owned mode-0600 password file.
POSTGRES_PASSWORD_FILE=/etc/wreckage/postgres-password
DB_URL=jdbc:postgresql://postgres:5432/wreckage
SPRING_PROFILES_ACTIVE=postgres
# Platform maintenance updates this only after Caddy passes HTTPS verification.
CADDY_IMAGE=caddy:2.10.2-alpine
# Container log rotation: size per file and total files per container.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=7
