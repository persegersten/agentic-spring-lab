# Public hostname only: no scheme, port, or path.
DOMAIN=wreckage.example.com

# PostgreSQL settings used by compose.prod.yml.
POSTGRES_DB=wreckage
POSTGRES_USER=wreckage
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DB_URL=jdbc:postgresql://postgres:5432/wreckage

# The production deployment must use durable PostgreSQL persistence.
SPRING_PROFILES_ACTIVE=postgres
